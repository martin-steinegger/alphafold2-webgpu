{
  "name": "afwebgpu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Differentially tested WebGPU kernels for AlphaFold 2 inference",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build --config vite.browser.config.ts",
    "export:web-model": "tsx tools/export-web-model.ts",
    "quantize:web-model": "tsx tools/quantize-web-model.ts",
    "verify:web-model": "tsx tools/verify-web-model.ts",
    "verify:pages-size": "tsx tools/verify-pages-artifact.ts",
    "upgrade:web-model": "tsx tools/upgrade-web-model.ts",
    "build:web:standalone": "npm run build:web && npm run export:web-model",
    "dev": "vite --config vite.browser.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gpu": "AFWEBGPU_GPU_TESTS=1 vitest run test/*.gpu.test.ts",
    "test:gpu:f16": "AFWEBGPU_GPU_TESTS=1 AFWEBGPU_ADAPTER=llvmpipe vitest run test/*.gpu.test.ts",
    "test:browser": "playwright test",
    "bench": "tsx tools/benchmark-triangle.ts",
    "bench:attention": "tsx tools/benchmark-attention.ts",
    "bench:a3m-stack": "tsx tools/benchmark-a3m-stack.ts",
    "bench:a3m-model": "tsx tools/benchmark-a3m-model.ts",
    "bench:shape": "tsx tools/benchmark-shape.ts",
    "bench:gemm": "tsx tools/benchmark-gemm.ts",
    "profile:a3m-model": "tsx tools/profile-a3m-model.ts",
    "qualify:hardware": "tsx tools/qualify-hardware.ts",
    "qualify:multimer": "tsx tools/qualify-multimer-model.ts",
    "check": "npm run build && npm run build:web && npm run test",
    "test:gpu:portable": "vitest run --no-file-parallelism test/gemm-half-precision.gpu.test.ts test/global-attention-large-grid.gpu.test.ts test/multimer-ipa.gpu.test.ts test/msa-clustering.gpu.test.ts test/msa-profile.gpu.test.ts test/multimer-relative.gpu.test.ts test/multimer-template-windows.gpu.test.ts test/runtime-execution.gpu.test.ts test/shader-compilation.gpu.test.ts test/a3m-features.test.ts test/multimer-features.test.ts test/multimer-process-features.test.ts test/triangle-multiplication-outgoing.gpu.test.ts",
    "dump:shaders": "tsx tools/dump-shaders.ts",
    "check:naga": "tsx tools/dump-shaders.ts /tmp/afwebgpu-shaders && ./tools/validate-naga.sh /tmp/afwebgpu-shaders"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@webgpu/types": "0.1.72",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "webgpu": "0.6.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "webgpu@0.6.0": true
  }
}
